{
  "name": "ScoreTurner 自动翻谱",
  "short_name": "ScoreTurner",
  "description": "乐谱自动翻页 + 节拍器：导入 PDF/图片乐谱，自动识别小节并跟随演奏翻页",
  "lang": "zh-CN",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#101418",
  "theme_color": "#101418",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "scores", "accept": ["application/pdf", "image/*", "*/*"] }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/open-file",
      "name": "用 ScoreTurner 打开乐谱",
      "accept": {
        "application/pdf": [".pdf"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/gif": [".gif"]
      }
    }
  ]
}
